rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Product photos ────────────────────────────────────────────────────────
    // Public read so customers can see them in the shop.
    // Only authenticated employees (admin claim) can upload or delete, and only
    // images, capped so a mis-picked file can't fill the bucket. The admin form
    // downscales to roughly 200–500 KB before uploading; this is the backstop.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && (request.resource == null
                       || (request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*')));
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
